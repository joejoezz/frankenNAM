# configure.nps for AWS arm64 (gfortran 13 + OpenMPI 4.1), dmpar build. Derived from
# configure.nps_wcoss2_dmpara with the Intel flags mapped: -fp-model strict -> plain -O3/-O2
# (no -ffast-math), -FR -> -ffree-form, -convert big_endian -> -fconvert=big-endian,
# -assume noold_ldout_format -> (list-directed output formatting, no gfortran equivalent),
# -r8 -> -fdefault-real-8 -fdefault-double-8, -qopenmp -auto -> -fopenmp, -traceback -> -fbacktrace,
# plus the GCC >= 10 relaxations and -mcpu=neoverse-v1. COMP_MP/COMPILER/C_COMP/C_COMP_MP come
# from build/build_nps.sh (mpif90/gfortran/gcc/mpicc). Rules and CPPFLAGS are untouched.
# configure.nps
#
# This file was automatically generated by the configure script in the
# top level directory. You may make changes to the settings in this
# file but be aware they will be overwritten each time you run configure.
# Ordinarily, it is necessary to run configure once, when the code is
# first installed.
#
# To permanently change options, change the settings for your platform
# in the file arch/configure.defaults, the preamble, and the postamble -
# then rerun configure.
#

.SUFFIXES: .F90 .f90 .F .f .c .o

SHELL           	=       /bin/sh

COMPRESSION_LIBS        =       ${JASPER_LIB} ${PNG_LIB} ${Z_LIB}

COMPRESSION_INC         =       ${JASPER_INC} ${PNG_INC} ${Z_INC}

NCARG_LIBS              =
NCARG_LIBS2		=

DIO                     =       $(DEV_TOP)/dio
DIO_INC                 =       -I${DIO}
DIO_LIBS                =       -L${DIO} -ldio

NCIO                     =       $(DEV_TOP)/ncio
NCIO_INC                 =       -I${NCIO}
NCIO_LIBS                =       -L${NCIO} -lncio

G2_LIBS                 =       ${G2_LIB4} $(COMPRESSION_LIBS)
G2_INCMOD               =       -I${G2_INC4}

W3_LIBS                 =       ${W3NCO_LIB4} ${W3EMC_LIB4}
W3D_LIBS                =       ${W3NCO_LIBd} ${W3EMC_LIBd}
IP_LIBS                 =       ${IP_LIBd}
IP_INCMOD               =       -I${IP_INCd}
SP_LIBS                 =       ${SP_LIB4}
SIGIO_LIBS              =       ${SIGIO_LIB}
SIGIO_INCMOD            =       -I${SIGIO_INC}

BACIO_LIBS              =       ${BACIO_LIB4}

NEMSIO_LIBS             =       ${NEMSIO_LIB}

LANDSFCUTIL_INC         =       -I${LANDSFCUTIL_INCd}
LANDSFCUTIL_LIBS        =       ${LANDSFCUTIL_LIBd}

FDEFS			=	-DUSE_JPEG2000 -DUSE_PNG

# Listing of options that are usually independent of machine type.
# When necessary, these are over-ridden by each architecture.

ARFLAGS			=

PERL			=	perl

RANLIB			=	echo

#### Architecture specific settings ####

# Settings for AWS arm64 Linux (Graviton), GNU gfortran + OpenMPI, DM parallel
#
ARCH_OPT       ?=       -mcpu=neoverse-v1
GNU_LEGACY      =       -fallow-argument-mismatch -fallow-invalid-boz -fno-range-check
FC              =       ${COMP_MP} -O3 -g -fbacktrace $(ARCH_OPT) $(GNU_LEGACY)
FCR             =       ${COMP_MP} -O2 -g -fbacktrace $(ARCH_OPT) $(GNU_LEGACY)
SFC             =       ${COMPILER} -O3 -g -fbacktrace $(ARCH_OPT) $(GNU_LEGACY)
FFLAGS          =       -ffree-form -fconvert=big-endian -ffree-line-length-none
F77FLAGS        =       -ffixed-form -fconvert=big-endian
FNGFLAGS        =       $(FFLAGS)
R8              =       -fdefault-real-8 -fdefault-double-8
LDFLAGS         =       -fopenmp
CC              =       ${C_COMP_MP} -O3 -fcommon $(ARCH_OPT)
SCC             =       ${C_COMP} -O3 -fcommon $(ARCH_OPT)
CFLAGS          =       -O
CPP             =       /lib/cpp -P -traditional
CPPFLAGS        =       -D_UNDERSCORE -DBYTESWAP -DLINUX -DIO_NETCDF -DIO_BINARY -DIO_DIO -DIO_GRIB1 -D_MPI -DBIT32

###########################################################
#
#	Macros, these should be generic for all machines

LN		=	ln -sf
MAKE		=	make -i -r
RM		= 	/bin/rm -f
CP		= 	/bin/cp
AR		=	ar ru

.IGNORE:
.SUFFIXES: .c .f90 .F90 .f .F .o

#	There is probably no reason to modify these rules

.c.o:
	$(RM) $@
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $<	

.f90.o:
	$(RM) $@ $*.mod
	$(CP) $< $*.f
	$(FC) $(FFLAGS) $(DIO_INC) $(NCIO_INC) -I$(NETCDF_INC) -I$(NEMSIO_INC) $(G2_INCMOD) -c $*.f
	$(RM) $*.f

.f.o:
	$(RM) $@ $*.mod
	$(FC) $(F77FLAGS) -c $<

.F90.o:
	$(RM) $@ $*.mod
	$(CPP) $(CPPFLAGS) $(FDEFS) $< > $*.f
	$(FC) $(FFLAGS) $(DIO_INC) $(NCIO_INC) -I$(NETCDF_INC) -I$(NEMSIO_INC) $(G2_INCMOD) -c $*.f
	$(RM) $*.f

.F.o:
	$(RM) $@ $*.mod
	$(CPP) $(CPPFLAGS) $(FDEFS) $< > $*.f
	$(FC) $(F77FLAGS) $(DIO_INC) $(NCIO_INC) -I$(NETCDF_INC) -I$(NEMSIO_INC) $(G2_INCMOD) -c $*.f
	$(RM) $*.f
