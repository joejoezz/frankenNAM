+
+! nam-recast: size() of a disassociated POINTER component is undefined; ifort happens to return
+! 0 (zeroed descriptor) and gengrb2msg relies on that for params without <level2> /
+! <scale_fact_fixed_sfc2> entries, gfortran segfaults. psize() returns 0 for a null pointer.
+  function psize_r(p) result(n)
+    real, dimension(:), pointer :: p
+    integer :: n
+    n = 0
+    if (associated(p)) n = size(p)
+  end function psize_r
+  function psize_i(p) result(n)
+    integer, dimension(:), pointer :: p
+    integer :: n
+    n = 0
+    if (associated(p)) n = size(p)
+  end function psize_i
   end module grib2_module
