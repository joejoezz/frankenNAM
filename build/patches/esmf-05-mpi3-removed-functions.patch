Reason: OpenMPI 4.x (and MPICH 4.x) no longer declare the MPI-1 functions removed in MPI-3.0 (MPI_Address, MPI_Type_struct, MPI_UB, MPI_Attr_get); Intel MPI still does, which is why Phase 0 never saw this. Only two compiled files use them: Zoltan's par_bisect.c (bisector struct type; rewritten with MPI_Get_address / MPI_Type_create_struct / MPI_Type_create_resized, same extent) and ESMCI_VMKernel.C (MPI_Attr_get -> MPI_Comm_get_attr, identical semantics). The other hits are in the mpiuni stub header and the MAPL addon mpif.h, which are not built.
--- a/src/Infrastructure/Mesh/src/Zoltan/par_bisect.c	2026-11-04 07:19:40
+++ b/src/Infrastructure/Mesh/src/Zoltan/par_bisect.c	2026-11-04 07:19:40
@@ -319,19 +319,24 @@
 
   /* create MPI data and function types for bisector */
   {
-    /* Describe struct bisector to MPI. Add MPI_UB at the end just to be safe. */
-    int lengths[4] = {2,5,4*MAX_BISECT_WGTS,1};
-    MPI_Aint ind[4], offset;
-    MPI_Datatype types[4] = {MPI_DOUBLE, MPI_INT, MPI_DOUBLE, MPI_UB};
-    MPI_Address(med, &offset);
-    ind[0] = 0;
-    MPI_Address(&(med->countlo), &(ind[1])); 
-    ind[1] -= offset;
-    MPI_Address(&(med->totallo[0]), &(ind[2])); 
-    ind[2] -= offset;
-    ind[3] = sizeof(struct bisector);
+    /* Describe struct bisector to MPI. nam-recast: MPI-3 form (MPI_Address, MPI_Type_struct
+       and MPI_UB were removed in MPI-3.0 and OpenMPI 4 no longer declares them); the extent
+       is pinned to sizeof(struct bisector) with MPI_Type_create_resized, which is what the
+       trailing MPI_UB entry did. */
+    int lengths[3] = {2,5,4*MAX_BISECT_WGTS};
+    MPI_Aint ind[3], offset;
+    MPI_Datatype types[3] = {MPI_DOUBLE, MPI_INT, MPI_DOUBLE};
+    MPI_Datatype med_type_unsized;
+    MPI_Get_address(med, &offset);
+    ind[0] = 0;
+    MPI_Get_address(&(med->countlo), &(ind[1]));
+    ind[1] -= offset;
+    MPI_Get_address(&(med->totallo[0]), &(ind[2]));
+    ind[2] -= offset;
 
-    MPI_Type_struct(4, lengths, ind, types, &med_type);
+    MPI_Type_create_struct(3, lengths, ind, types, &med_type_unsized);
+    MPI_Type_create_resized(med_type_unsized, 0, sizeof(struct bisector), &med_type);
+    MPI_Type_free(&med_type_unsized);
     MPI_Type_commit(&med_type);
 
     MPI_Op_create(&Zoltan_bisector_merge, 1, &med_op);
